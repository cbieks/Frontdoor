# Copy this file to .env and fill in values for local development.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://frontdoor:frontdoor@localhost:5432/frontdoor?schema=public"

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_SCORING_MODEL="claude-haiku-4-5-20251001"

# ── Scraping & scoring ────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=""
SCRAPER_MAX_RESULTS="50"
FIRECRAWL_API_KEY=""                # https://www.firecrawl.dev/ — used to scrape outdated-website leads
SCORING_REJECT_THRESHOLD="25"       # leads scored at or below this are auto-rejected

# ── Vercel ────────────────────────────────────────────────────────────────────
VERCEL_API_TOKEN=""
VERCEL_TEAM_ID=""
VERCEL_ORG_ID=""

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DASHBOARD_PASSWORD=""               # Simple shared password protecting /dashboard
CRON_SECRET=""                      # Bearer token for cron-triggered API routes

# ── Docker ───────────────────────────────────────────────────────────────────────
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""